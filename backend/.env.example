APP_ENV=development
VERSION=0.1.0
HTTP_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:3000
METRICS_AUTH_TOKEN=

# Local Docker Compose
DATABASE_URL=postgres://geoguess:geoguess@localhost:5432/geoguess?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Cloud providers (Neon + Upstash)
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
# REDIS_URL=rediss://default:<password>@<upstash-host>:6379

HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=15
HTTP_IDLE_TIMEOUT_SECONDS=60

# Auth
ACCESS_TOKEN_SECRET=change-me-in-production-access-token-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_SECRET=change-me-in-production-refresh-token-secret-min-32-chars
REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_SECRET=change-me-in-production-csrf-secret-min-32-chars
GUEST_SESSION_SECRET=change-me-in-production-guest-secret-min-32-chars
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/oauth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:3000/api/auth/oauth/discord/callback
OAUTH_STATE_TTL_SECONDS=600

# Email / OTP
EMAIL_PROVIDER=logger
EMAIL_FROM=noreply@geoguess.local
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=3

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_SIGNED_URL_TTL_SECONDS=900
R2_MAX_FILE_SIZE_BYTES=10485760

# Challenges
# Canonical daily reset hour in UTC, 0-23.
CHALLENGE_RESET_HOUR_UTC=0
# Optional explicit map UUID. When unset, the newest active public map with
# enough active locations for all daily rounds is selected automatically.
CHALLENGE_DEFAULT_MAP_ID=

# Quick Play (POST /api/v1/games/quick-play) — server-owned defaults; clients never send map/timer.
# Prefer an active public map UUID with enough locations for QUICK_PLAY_ROUND_COUNT.
# Fallback chain (resolved at config load): QUICK_PLAY_DEFAULT_MAP_ID, else
# CHALLENGE_DEFAULT_MAP_ID, else MATCHMAKING_DEFAULT_MAP_ID.
# With no map configured anywhere, the endpoint returns HTTP 503 quick_play_unavailable.
QUICK_PLAY_DEFAULT_MAP_ID=
QUICK_PLAY_ROUND_COUNT=5
QUICK_PLAY_TIMER_SECONDS=60

# Private rooms / realtime
ROOM_RECONNECT_GRACE_SECONDS=30
ROOM_HEARTBEAT_INTERVAL_SECONDS=10
ROOM_PRESENCE_TTL_SECONDS=30
# Optional explicit WebSocket origin host override for room realtime checks.
ROOM_REALTIME_ALLOWED_HOST=

# Ranked matchmaking (Phase 9)
# Active public map UUID with enough locations for MATCHMAKING_ROUND_COUNT rounds.
MATCHMAKING_DEFAULT_MAP_ID=
# Searching activity lease; status polling renews without changing queue priority.
MATCHMAKING_QUEUE_LEASE_SECONDS=30
# Short-lived pair claim TTL while durable formation commits.
MATCHMAKING_CLAIM_TTL_SECONDS=15
# Server-controlled countdown before the first ranked round accepts guesses.
MATCHMAKING_START_DELAY_SECONDS=5
MATCHMAKING_ROUND_COUNT=5
MATCHMAKING_TIMER_SECONDS=60
# Max candidate inspections per formation attempt.
MATCHMAKING_CANDIDATE_SCAN_LIMIT=20

# Casual / Ranked team modes (012)
# Keep all feature flags false until migration 00019 succeeds and rollout is ready.
CASUAL_MATCHMAKING_ENABLED=false
RANKED_TEAM_MODES_ENABLED=false
TEAM_CHAT_IMAGES_ENABLED=false
# Party invite lifetime (15 minutes).
PARTY_INVITE_TTL_SECONDS=900
# Disconnect grace before Ranked forfeit / presence expiry.
MATCH_RECONNECT_GRACE_SECONDS=90
# Casual match closes after this long with no accepted activity.
CASUAL_INACTIVITY_SECONDS=600
# Background worker intervals (bounded sweeps).
MATCH_SWEEP_INTERVAL_SECONDS=5
MATCH_CLAIM_SWEEP_INTERVAL_SECONDS=5
# Competitive season / Elo constants.
COMPETITIVE_SEASON_DURATION_DAYS=84
COMPETITIVE_INITIAL_RATING=800
COMPETITIVE_ELO_K=32
# Soft season reset toward initial rating, basis points (5000 = 50%).
COMPETITIVE_RESET_FACTOR_BPS=5000
COMPETITIVE_ABANDON_PENALTY=15
COMPETITIVE_TOP500_MIN_MATCHES=25
# One-time WebSocket tickets and hub limits.
REALTIME_TICKET_TTL_SECONDS=30
# Comma-separated browser origins allowed for party/match WebSocket upgrade.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
REALTIME_OUTBOUND_QUEUE_SIZE=128
# Team chat retention and image sanitization caps.
TEAM_CHAT_RETENTION_DAYS=30
TEAM_CHAT_REPORT_RETENTION_DAYS=180
TEAM_CHAT_IMAGE_MAX_BYTES=5242880
TEAM_CHAT_IMAGE_MAX_PIXELS=20000000
TEAM_CHAT_IMAGE_MAX_DIMENSION=2048
TEAM_CHAT_CLEANUP_INTERVAL_SECONDS=900
